# ─────────────────────────────────────────────────────
# UniDesk — Spring Boot Application Properties
# ─────────────────────────────────────────────────────

spring.application.name=UniDesk

# ── Database ──────────────────────────────────────────
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=UniDesk;encrypt=true;trustServerCertificate=true
spring.datasource.username=unidesk
spring.datasource.password=CHANGE_ME_db_password
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# ── JPA / Hibernate ──────────────────────────────────
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.SQLServerDialect
spring.jpa.properties.hibernate.format_sql=true

# ── Server ────────────────────────────────────────────
server.port=8080

# ── JWT ──────────────────────────────────────────────
# Generate a strong base64 secret: openssl rand -base64 64
app.jwt.secret=CHANGE_ME_at_least_64_random_characters_for_HS512
app.jwt.access-token-expiry-ms=900000
app.jwt.refresh-token-expiry-ms=604800000

# ── File Storage ──────────────────────────────────────
app.file.upload-dir=./uploads
app.file.max-size-bytes=10485760
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# ── CORS ─────────────────────────────────────────────
app.cors.allowed-origins=http://localhost:5173

# ── Email (registration verification) ──────────────────
# Shared sending account for the whole group — do not change.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=sasandiwijetunga@gmail.com
spring.mail.password=CHANGE_ME_gmail_app_password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.mail.from=sasandiwijetunga@gmail.com

# ── Logging ──────────────────────────────────────────
logging.level.edu.unidesk=INFO
logging.level.org.springframework.security=WARN
# Never log passwords — keep SQL logging off in production
logging.level.org.hibernate.SQL=WARN
